<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Integrations service (ADR-0001, ADR-0014): a separate process with its own lifecycle. It publishes the transactional
    outbox to RabbitMQ (crewcall.events) and runs the technical integration-audit consumer. The only project that
    references RabbitMQ.Client: business modules and the API never talk to the broker.
  -->

  <ItemGroup>
    <ProjectReference Include="..\CrewCall.ServiceDefaults\CrewCall.ServiceDefaults.csproj" />
    <ProjectReference Include="..\CrewCall.Persistence\CrewCall.Persistence.csproj" />
    <ProjectReference Include="..\CrewCall.Contracts\CrewCall.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

</Project>
