{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Outbox": {
    "BatchSize": 50,
    "PollInterval": "00:00:01",
    "LeaseDuration": "00:00:30",
    "PublishTimeout": "00:00:10",
    "MaxAttempts": 10,
    "BaseRetryDelay": "00:00:02",
    "MaxRetryDelay": "00:05:00"
  },
  "LiveOperations": {
    "QueueName": "crewcall.live-operations",
    "ConsumerName": "crewcall-live-operations",
    "PrefetchCount": 20,
    "ReconnectDelay": "00:00:02",
    "RequeueDelay": "00:00:01"
  }
}
