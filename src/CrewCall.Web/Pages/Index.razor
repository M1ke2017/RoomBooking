@page "/"

@using System.Net.Http.Json
@using RoomBooking.Client.Models
@using RoomBooking.Client.Services
@inject HttpClient Http
@inject ActivityLogService Log

<div class="container home-layout">

    <h2 class="mb-1">
        RoomBooking <span class="home-subtitle">– panel zarządzania</span>
    </h2>

    <p class="lead mb-2">
        Jedna strona, na której możesz zarządzać salami, użytkownikami i rezerwacjami.
    </p>

   
    <div class="row g-2 mb-2">
        <div class="col-sm-4">
            <div class="card p-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span>Sale</span>
                    <strong>@(rooms?.Count ?? 0)</strong>
                </div>
                <small class="text-muted">Liczba zdefiniowanych sal</small>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card p-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span>Użytkownicy</span>
                    <strong>@(users?.Count ?? 0)</strong>
                </div>
                <small class="text-muted">Zarejestrowani użytkownicy</small>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card p-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span>Rezerwacje</span>
                    <strong>@(reservations?.Count ?? 0)</strong>
                </div>
                <small class="text-muted">Wszystkie rezerwacje</small>
            </div>
        </div>
    </div>

  
    <div class="main-layout">
        
        <div class="main-left">
            <div class="cards-grid">
                
                <div>
                    <div class="card section-card p-3 h-100 d-flex flex-column">
                        <h6 class="section-heading">SALE</h6>
                        <p class="section-text mb-2">
                            Moduł do zarządzania salami (nazwa, pojemność).
                            Dane są zapisywane w bazie przez API <code>api/rooms</code>.
                        </p>

                        
                        <div class="mb-2">
                            <label class="form-label-sm">Dodaj salę</label>
                            <input class="form-control form-control-sm mb-1"
                                   placeholder="Nazwa"
                                   @bind="newRoom.Name" />
                            <input class="form-control form-control-sm mb-2"
                                   type="number"
                                   min="1"
                                   placeholder="Pojemność"
                                   @bind="newRoom.Capacity" />

                            <button class="btn btn-primary btn-sm"
                                    @onclick="AddRoom">
                                Dodaj salę
                            </button>
                        </div>

                       
                        <div class="mt-2 flex-grow-1 d-flex flex-column">
                            <label class="form-label-sm mb-1">Lista sal</label>

                            @if (rooms == null)
                            {
                                <div class="text-muted">Ładowanie sal...</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(roomsError))
                            {
                                <div class="text-danger">@roomsError</div>
                            }
                            else if (!rooms.Any())
                            {
                                <div class="text-muted">
                                    Brak sal – dodaj pierwszą powyżej.
                                </div>
                            }
                            else
                            {
                                <div class="list-panel">
                                    <table class="table table-sm table-dark table-striped mb-0">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Nazwa</th>
                                                <th>Poj.</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in rooms)
                                            {
                                                <tr>
                                                    <td>@r.Id</td>
                                                    <td>@r.Name</td>
                                                    <td>@r.Capacity</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                
                <div>
                    <div class="card section-card p-3 h-100 d-flex flex-column">
                        <h6 class="section-heading">UŻYTKOWNICY</h6>
                        <p class="section-text mb-2">
                            Moduł zarządzania użytkownikami (imię i nazwisko, e-mail).
                            Komunikacja z API <code>api/users</code>.
                        </p>

                        
                        <div class="mb-2">
                            <label class="form-label-sm">Dodaj użytkownika</label>
                            <input class="form-control form-control-sm mb-1"
                                   placeholder="Imię i nazwisko"
                                   @bind="newUser.Name" />
                            <input class="form-control form-control-sm mb-2"
                                   placeholder="E-mail"
                                   @bind="newUser.Email" />

                            <button class="btn btn-primary btn-sm"
                                    @onclick="AddUser">
                                Dodaj użytkownika
                            </button>
                        </div>

                        
                        <div class="mt-2 flex-grow-1 d-flex flex-column">
                            <label class="form-label-sm mb-1">Lista użytkowników</label>

                            @if (users == null)
                            {
                                <div class="text-muted">Ładowanie użytkowników...</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(usersError))
                            {
                                <div class="text-danger">@usersError</div>
                            }
                            else if (!users.Any())
                            {
                                <div class="text-muted">
                                    Brak użytkowników – dodaj pierwszego powyżej.
                                </div>
                            }
                            else
                            {
                                <div class="list-panel">
                                    <table class="table table-sm table-dark table-striped mb-0">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Imię i nazwisko</th>
                                                <th>E-mail</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var u in users)
                                            {
                                                <tr>
                                                    <td>@u.Id</td>
                                                    <td>@u.Name</td>
                                                    <td>@u.Email</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                
                <div>
                    <div class="card section-card p-3 h-100 d-flex flex-column">
                        <h6 class="section-heading">REZERWACJE</h6>
                        <p class="section-text mb-2">
                            Tworzenie rezerwacji z walidacją konfliktów i dni świątecznych.
                            API: <code>api/reservations</code>.
                        </p>

                       
                        <div class="mb-2">
                            <label class="form-label-sm mb-1">Nowa rezerwacja</label>

                            @if (rooms == null || users == null)
                            {
                                <div class="text-muted">
                                    Ładowanie danych sal i użytkowników...
                                </div>
                            }
                            else
                            {
                                <div class="mb-2">
                                    <label class="form-label-sm">Sala</label>
                                    <select class="form-select form-select-sm"
                                            @bind="newReservation.RoomId">
                                        <option value="0">-- wybierz salę --</option>
                                        @foreach (var r in rooms)
                                        {
                                            <option value="@r.Id">@r.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label-sm">Użytkownik</label>
                                    <select class="form-select form-select-sm"
                                            @bind="newReservation.UserId">
                                        <option value="0">-- wybierz użytkownika --</option>
                                        @foreach (var u in users)
                                        {
                                            <option value="@u.Id">@u.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label-sm">Data</label>
                                    <input type="date"
                                           class="form-control form-control-sm"
                                           @bind="date" />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label-sm">Od (godzina)</label>
                                    <input type="time"
                                           class="form-control form-control-sm"
                                           @bind="startTime" />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label-sm">Do (godzina)</label>
                                    <input type="time"
                                           class="form-control form-control-sm"
                                           @bind="endTime" />
                                </div>

                                <button class="btn btn-primary btn-sm"
                                        @onclick="AddReservation">
                                    Zarezerwuj
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(reservationsError))
                        {
                            <div class="text-danger mb-2">@reservationsError</div>
                        }

                        
                        <div class="mt-2 flex-grow-1 d-flex flex-column">
                            <label class="form-label-sm mb-1">Lista rezerwacji</label>

                            @if (reservations == null)
                            {
                                <div class="text-muted">Ładowanie rezerwacji...</div>
                            }
                            else if (!reservations.Any())
                            {
                                <div class="text-muted">
                                    Brak rezerwacji – utwórz pierwszą powyżej.
                                </div>
                            }
                            else
                            {
                                <div class="list-panel">
                                    <table class="table table-sm table-dark table-striped mb-0">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Sala</th>
                                                <th>Użytkownik</th>
                                                <th>Od</th>
                                                <th>Do</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var resv in reservations)
                                            {
                                                <tr>
                                                    <td>@resv.Id</td>
                                                    <td>@GetRoomName(resv.RoomId)</td>
                                                    <td>@GetUserName(resv.UserId)</td>
                                                    <td>@resv.StartUtc.ToLocalTime().ToString("dd.MM HH:mm")</td>
                                                    <td>@resv.EndUtc.ToLocalTime().ToString("dd.MM HH:mm")</td>
                                                    <td>@resv.Status</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>

        
        <div class="main-right">
            <div class="cards-column">
                <div class="card p-3">
                    <h5 class="mb-2">Jak działa cały przepływ?</h5>
                    <ol class="flow-list mb-0">
                        <li>Użytkownik na froncie (Blazor) tworzy rezerwację.</li>
                        <li>Żądanie trafia do <strong>BookingService</strong>.</li>
                        <li>BookingService sprawdza konflikt w bazie (EF Core + Postgres).</li>
                        <li>Przed zapisem pyta <strong>IntegrationService</strong>, czy dzień nie jest świętem.</li>
                        <li>Wynik wraca na frontend i jest dopisywany do logu.</li>
                    </ol>
                </div>

                <div class="card p-3">
                    <h5 class="mb-2">Symulacja pracy serwisu</h5>
                    <p class="section-text mb-2">
                        Backendowy symulator korzysta z istniejących danych:
                        z bazy wybiera użytkowników z e-mailem <code>@@demo.local</code>,
                        czyści ich rezerwacje i tworzy nowe na najbliższe dni.
                    </p>
                    <button class="btn btn-primary btn-sm"
                            @onclick="RunServiceSimulation"
                            disabled="@isServiceRunning">
                        @(isServiceRunning ? "Praca serwisu w toku..." : "Uruchom pracę serwisu")
                    </button>
                </div>

                <div class="card p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">Log działania aplikacji</h5>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearLog">
                            Wyczyść log
                        </button>
                    </div>

                    <small class="text-muted d-block mb-2">
                        Ostatnie @Log.Entries.Count wpisów
                    </small>

                    <div class="log-panel p-2">
                        @if (!Log.Entries.Any())
                        {
                            <div class="text-muted">
                                Brak wpisów – wykonaj operacje po lewej
                                lub uruchom pracę serwisu.
                            </div>
                        }
                        else
                        {
                            @foreach (var entry in Log.Entries)
                            {
                                <div class="log-entry">
                                    <span class="log-time">
                                        @entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                                    </span>
                                    <span class="log-source">@entry.Source</span>
                                    <span class="log-message">@entry.Message</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Room>? rooms;
    private List<User>? users;
    private List<Reservation>? reservations;

    private Room newRoom = new() { Capacity = 10 };
    private User newUser = new();
    private Reservation newReservation = new();

    private DateTime date = DateTime.Today;
    private TimeOnly startTime = new(10, 0);
    private TimeOnly endTime = new(11, 0);

    private string? roomsError;
    private string? usersError;
    private string? reservationsError;

    private bool isServiceRunning;

    protected override async Task OnInitializedAsync()
    {
        await LoadRooms();
        await LoadUsers();
        await LoadReservations();
    }

    private async Task LoadRooms()
    {
        try
        {
            roomsError = null;
            rooms = await Http.GetFromJsonAsync<List<Room>>("api/rooms");
            Log.Add("Rooms", $"Pobrano listę sal (liczba: {rooms?.Count ?? 0}).");
        }
        catch (Exception ex)
        {
            roomsError = "Błąd podczas pobierania sal.";
            Log.Add("Frontend", $"BŁĄD przy pobieraniu sal: {ex.Message}");
        }
    }

    private async Task LoadUsers()
    {
        try
        {
            usersError = null;
            users = await Http.GetFromJsonAsync<List<User>>("api/users");
            Log.Add("Users", $"Pobrano listę użytkowników (liczba: {users?.Count ?? 0}).");
        }
        catch (Exception ex)
        {
            usersError = "Błąd podczas pobierania użytkowników.";
            Log.Add("Frontend", $"BŁĄD przy pobieraniu użytkowników: {ex.Message}");
        }
    }

    private async Task LoadReservations()
    {
        try
        {
            reservationsError = null;
            reservations = await Http.GetFromJsonAsync<List<Reservation>>("api/reservations");
            Log.Add("Reservations", $"Pobrano listę rezerwacji (liczba: {reservations?.Count ?? 0}).");
        }
        catch (Exception ex)
        {
            reservationsError = "Błąd podczas pobierania rezerwacji.";
            Log.Add("Frontend", $"BŁĄD przy pobieraniu rezerwacji: {ex.Message}");
        }
    }

    private async Task AddRoom()
    {
        if (string.IsNullOrWhiteSpace(newRoom.Name) || newRoom.Capacity <= 0)
            return;

        try
        {
            var response = await Http.PostAsJsonAsync("api/rooms", newRoom);
            response.EnsureSuccessStatusCode();

            var created = await response.Content.ReadFromJsonAsync<Room>();
            if (created != null)
            {
                rooms ??= new List<Room>();
                rooms.Add(created);
                Log.Add("Rooms", $"Dodano salę '{created.Name}' (Id={created.Id}, Capacity={created.Capacity}).");
            }

            newRoom = new Room { Capacity = 10 };
        }
        catch (Exception ex)
        {
            roomsError = "Błąd podczas dodawania sali.";
            Log.Add("Frontend", $"BŁĄD przy dodawaniu sali: {ex.Message}");
        }
    }

    private async Task AddUser()
    {
        if (string.IsNullOrWhiteSpace(newUser.Name) || string.IsNullOrWhiteSpace(newUser.Email))
            return;

        try
        {
            var response = await Http.PostAsJsonAsync("api/users", newUser);
            response.EnsureSuccessStatusCode();

            var created = await response.Content.ReadFromJsonAsync<User>();
            if (created != null)
            {
                users ??= new List<User>();
                users.Add(created);
                Log.Add("Users", $"Dodano użytkownika '{created.Name}' ({created.Email}).");
            }

            newUser = new User();
        }
        catch (Exception ex)
        {
            usersError = "Błąd podczas dodawania użytkownika.";
            Log.Add("Frontend", $"BŁĄD przy dodawaniu użytkownika: {ex.Message}");
        }
    }

    private async Task AddReservation()
    {
        reservationsError = null;

        if (newReservation.RoomId == 0 || newReservation.UserId == 0)
        {
            reservationsError = "Wybierz salę i użytkownika.";
            return;
        }

        var startLocal = date.Date.Add(startTime.ToTimeSpan());
        var endLocal = date.Date.Add(endTime.ToTimeSpan());

        if (endLocal <= startLocal)
        {
            reservationsError = "Godzina końca musi być później niż początek.";
            return;
        }

        newReservation.StartUtc = startLocal.ToUniversalTime();
        newReservation.EndUtc = endLocal.ToUniversalTime();
        newReservation.Status = ReservationStatus.Active;

        try
        {
            var response = await Http.PostAsJsonAsync("api/reservations", newReservation);

            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<Reservation>();
                if (created != null)
                {
                    reservations ??= new List<Reservation>();
                    reservations.Add(created);

                    Log.Add("Reservations",
                        $"Dodano rezerwację (Id={created.Id}) – Sala: {GetRoomName(created.RoomId)}, " +
                        $"Użytkownik: {GetUserName(created.UserId)}, " +
                        $"Od: {created.StartUtc.ToLocalTime()}, Do: {created.EndUtc.ToLocalTime()}.");
                }
            }
            else
            {
                var text = await response.Content.ReadAsStringAsync();
                Log.Add("Reservations",
                    $"Nie udało się dodać rezerwacji – {response.StatusCode}: {text}");
                reservationsError = "Nie udało się utworzyć rezerwacji.";
            }
        }
        catch (Exception ex)
        {
            reservationsError = "Błąd połączenia z serwerem podczas tworzenia rezerwacji.";
            Log.Add("Frontend", $"BŁĄD AddReservation: {ex.Message}");
        }
    }

    private async Task RunServiceSimulation()
    {
        if (isServiceRunning)
            return;

        isServiceRunning = true;
        Log.Add("Service", "Start symulacji pracy serwisu (backend).");

        try
        {
            var response = await Http.PostAsync("api/service/simulate", null);
            var text = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = System.Text.Json.JsonSerializer.Deserialize<ServiceSimulationResult>(text);
                var created = result?.Created ?? 0;
                var usersCount = result?.DemoUsers ?? 0;

                Log.Add("Service",
                    $"Symulacja zakończona – utworzono {created} rezerwacji " +
                    $"dla {usersCount} użytkowników demo.");
            }
            else
            {
                Log.Add("Service",
                    $"Symulacja zwróciła błąd: {(int)response.StatusCode} {response.StatusCode}. " +
                    $"Treść: {text}");
            }

            await LoadRooms();
            await LoadUsers();
            await LoadReservations();
        }
        catch (Exception ex)
        {
            Log.Add("Service", $"BŁĄD przy wywołaniu symulacji: {ex.Message}");
        }
        finally
        {
            isServiceRunning = false;
            StateHasChanged();
        }
    }

    private string GetRoomName(int roomId)
        => rooms?.FirstOrDefault(r => r.Id == roomId)?.Name ?? $"Sala {roomId}";

    private string GetUserName(int userId)
        => users?.FirstOrDefault(u => u.Id == userId)?.Name ?? $"Użytkownik {userId}";

    private void ClearLog() => Log.Clear();

    private sealed class ServiceSimulationResult
    {
        public int Created { get; set; }
        public int DemoUsers { get; set; }
    }
}
