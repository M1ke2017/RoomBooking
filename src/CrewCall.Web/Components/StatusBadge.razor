<span class="badge badge-@State.ToString().ToLowerInvariant()">@Label</span>

@code {
    [Parameter, EditorRequired]
    public ComponentState State { get; set; }

    private string Label => State switch
    {
        ComponentState.Healthy => "Działa",
        ComponentState.Degraded => "Częściowo",
        ComponentState.Unavailable => "Niedostępne",
        _ => "Nieznany"
    };
}
