@page "/status"
@attribute [StreamRendering]
@inject SystemStatusClient StatusClient

<PageTitle>CrewCall · Stan systemu</PageTitle>

<section class="panel" aria-labelledby="system-status">
    <div class="panel-header">
        <h1 id="system-status">Stan systemu</h1>
        <a class="refresh" href="/status">Odśwież</a>
    </div>

    @if (status is null)
    {
        <p class="muted">Sprawdzanie…</p>
    }
    else
    {
        <table class="status-table">
            <thead>
                <tr>
                    <th scope="col">Komponent</th>
                    <th scope="col">Stan</th>
                    <th scope="col">Szczegóły</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>API</td>
                    <td><StatusBadge State="status.Api.State" /></td>
                    <td class="detail">@status.Api.Detail</td>
                </tr>
                <tr>
                    <td>Baza danych</td>
                    <td><StatusBadge State="status.Database.State" /></td>
                    <td class="detail">@status.Database.Detail</td>
                </tr>
            </tbody>
        </table>

        <dl class="meta">
            <dt>Adres API</dt>
            <dd><code>@status.ApiService</code></dd>
            <dt>Sprawdzono</dt>
            <dd>@status.CheckedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
        </dl>
    }

    <p class="muted"><a href="/operations">Operacje</a> · Narzędzia deweloperskie: <a href="/live">surowy strumień zdarzeń na żywo</a></p>
</section>

@code {
    private SystemStatus? status;

    protected override async Task OnInitializedAsync()
    {
        status = await StatusClient.GetAsync();
    }
}
