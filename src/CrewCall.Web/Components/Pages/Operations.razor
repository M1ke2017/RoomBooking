@page "/"
@page "/operations"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using CrewCall.Contracts.Incidents
@using CrewCall.Contracts.Live
@using CrewCall.Contracts.OperationalCalendar
@using CrewCall.Contracts.Operations
@using CrewCall.Contracts.Reporting
@using CrewCall.Web.Live
@using CrewCall.Web.Operations
@inject OperationsApiClient Api
@inject ReportingApiClient Reporting
@inject IServiceProvider Services
@inject IConfiguration Configuration

<PageTitle>CrewCall · Operacje</PageTitle>

<div class="ops">
    <header class="ops-header">
        <div>
            <h1>Operacje</h1>
            <p class="muted">@DayLabel</p>
        </div>
        <div class="ops-toolbar">
            <button class="btn" @onclick="() => ShiftDayAsync(-1)" aria-label="Poprzedni dzień">‹</button>
            <button class="btn" @onclick="TodayAsync">Dziś</button>
            <button class="btn" @onclick="() => ShiftDayAsync(1)" aria-label="Następny dzień">›</button>
            <span class="live-pill live-pill-@live.ToString().ToLowerInvariant()" title="@(liveUpdatedAt is { } at ? $"Ostatnia zmiana na żywo: {at:HH:mm:ss}" : "Aktualizacje na żywo")">
                @LiveLabel
            </span>
        </div>
    </header>

    @if (error is not null)
    {
        <p class="notice notice-error">@error</p>
    }

    @if (board is null)
    {
        <p class="muted">Wczytywanie planu…</p>
    }
    else
    {
        @if (board.Alerts.Length > 0)
        {
            <section class="card alerts" aria-labelledby="alerts">
                <h2 id="alerts">Uwaga <span class="count">@board.Alerts.Length</span></h2>
                <ul>
                    @foreach (var alert in board.Alerts)
                    {
                        <li class="alert alert-@alert.Severity.ToLowerInvariant()">@AlertText(alert)</li>
                    }
                </ul>
            </section>
        }

        <div class="ops-grid">
            <div class="ops-main">
                <section class="card" aria-labelledby="urgent">
                    <h2 id="urgent">Pilne zgłoszenia <span class="count">@board.Incidents.Length</span></h2>
                    @if (board.Incidents.Length == 0)
                    {
                        <p class="muted">Brak pilnych zgłoszeń.</p>
                    }
                    @foreach (var entry in board.Incidents)
                    {
                        var incident = entry.Incident;
                        var panel = PanelOf(incident.Id);
                        var open = incident.WorkOrderId is null && incident.Status is "New" or "Analyzing" or "ReadyForDispatch";
                        <article class="item incident @(open ? "incident-open" : "")">
                            <div class="item-head">
                                <span class="tag tag-@incident.Priority.ToLowerInvariant()">@Priority(incident.Priority)</span>
                                <strong>@incident.Title</strong>
                                <span class="tag tag-status">@IncidentStatus(incident.Status)</span>
                            </div>
                            <p>@entry.CustomerName — @entry.SiteName, @entry.SiteCity</p>
                            <p class="muted">Termin: @Time(incident.RequestedStart)–@Time(incident.RequestedEnd)@(incident.RequiredSkillCodes.Length > 0 ? $" · wymagane: {string.Join(", ", incident.RequiredSkillCodes)}" : "")</p>
                            @if (entry.Analysis is { } analysis)
                            {
                                <p class="muted">
                                    Analiza @Time(analysis.AnalyzedAtUtc): @analysis.DirectAssignmentCount wolnych,
                                    @analysis.RequiresRescheduleCount wymaga przesunięcia, @analysis.UnavailableCount niedostępnych
                                    @(open ? (analysis.DirectAssignmentCount > 0 ? "→ propozycja bez przesunięcia" : analysis.RequiresRescheduleCount > 0 ? "→ propozycja z przesunięciem" : "") : "")
                                </p>
                            }
                            @if (panel.Message is { } message)
                            {
                                <p class="notice notice-ok">@message</p>
                            }
                            @if (panel.Error is { } panelError)
                            {
                                <p class="notice notice-error">@panelError</p>
                            }
                            @if (open)
                            {
                                <div class="actions">
                                    <button class="btn" disabled="@panel.Busy" @onclick="() => AnalyzeAsync(incident.Id)">Analizuj</button>
                                    <button class="btn" disabled="@(panel.Busy || incident.Status != "ReadyForDispatch")" @onclick="() => ProposeAsync(incident.Id)">Pokaż propozycję</button>
                                </div>
                            }
                            @if (open && panel.Proposals is { } proposals)
                            {
                                @if (proposals.Length == 0)
                                {
                                    <p class="muted">Brak propozycji: nikt z zespołu nie pasuje do tego zgłoszenia.</p>
                                }
                                @foreach (var proposal in proposals.Take(3))
                                {
                                    var moved = proposal.ConflictingVisitId is { } conflictingId ? board.Today.FirstOrDefault(item => item.VisitId == conflictingId) : null;
                                    <div class="proposal @(proposal.IsFeasible ? "" : "proposal-infeasible")">
                                        <div class="item-head">
                                            <strong>#@proposal.Rank @proposal.TechnicianName</strong>
                                            <span class="tag @(proposal.IsFeasible ? "tag-ok" : "tag-bad")">@(proposal.IsFeasible ? (proposal.ConflictingVisitId is null ? "bez przesunięcia" : "z przesunięciem") : "niewykonalna")</span>
                                        </div>
                                        <dl class="facts">
                                            <dt>Zgłoszenie</dt><dd>@Time(proposal.UrgentVisitStartUtc)–@Time(proposal.UrgentVisitEndUtc)</dd>
                                            @if (proposal.ConflictingVisitId is not null)
                                            {
                                                <dt>Konflikt</dt><dd>@(moved?.WorkOrderTitle ?? "wizyta") (@Priority(proposal.ConflictingPriority ?? "")) — @(moved is null ? "" : $"{moved.CustomerName}, {moved.SiteCity}")</dd>
                                            }
                                            @if (proposal.ProposedNewStartUtc is { } newStart && proposal.Impact.AffectedVisits.FirstOrDefault() is { } affected)
                                            {
                                                <dt>Przesunięcie</dt><dd>@Time(affected.OldStartUtc)–@Time(affected.OldEndUtc) → <strong>@Time(newStart)–@Time(proposal.ProposedNewEndUtc!.Value)</strong> (+@proposal.Impact.DelayMinutes min)</dd>
                                                <dt>Klient</dt><dd>@(moved?.CustomerName ?? affected.CustomerId.ToString())</dd>
                                            }
                                            <dt>Pojazd</dt><dd>@(proposal.VehicleId is null ? (moved?.VehicleRegistrationNumber is { } registration ? $"{registration} (przesuwana wizyta)" : "—") : proposal.VehicleId.ToString())</dd>
                                            <dt>Sprzęt</dt><dd>@(proposal.EquipmentIds.Count == 0 ? "—" : $"{proposal.EquipmentIds.Count} szt.")</dd>
                                        </dl>
                                        @foreach (var warning in Warnings(proposal, moved, incident.Priority))
                                        {
                                            <p class="warning">⚠ @warning</p>
                                        }
                                        @if (proposal.IsFeasible)
                                        {
                                            <button class="btn btn-primary" disabled="@panel.Busy" @onclick="() => AcceptAsync(incident.Id, proposal)">Akceptuj</button>
                                        }
                                    </div>
                                }
                            }
                        </article>
                    }
                </section>

                <section class="card" aria-labelledby="today">
                    <h2 id="today">Dzisiaj <span class="count">@board.Today.Length</span></h2>
                    @if (board.Today.Length == 0)
                    {
                        <p class="muted">Brak zaplanowanych wizyt na ten dzień.</p>
                        <button class="btn" @onclick="SeedDemoAsync">Przygotuj dane demo</button>
                    }
                    @foreach (var visit in board.Today)
                    {
                        <article class="item visit visit-@visit.FieldWorkStatus.ToLowerInvariant()">
                            <div class="item-head">
                                <span class="time">@visit.VisitLocalStart.ToString("HH:mm")–@visit.VisitLocalEnd.ToString("HH:mm")</span>
                                <strong>@(visit.TechnicianName ?? "Bez technika")</strong>
                                <span class="tag tag-@visit.WorkOrderPriority.ToLowerInvariant()">@Priority(visit.WorkOrderPriority)</span>
                                <span class="tag tag-work-@visit.FieldWorkStatus.ToLowerInvariant()">@FieldWork(visit.FieldWorkStatus)</span>
                            </div>
                            <p>@visit.CustomerName — @visit.SiteName, @visit.SiteCity</p>
                            <p class="muted">@visit.WorkOrderTitle · @VisitStatus(visit.VisitStatus)@(visit.VehicleRegistrationNumber is { } registration ? $" · {visit.VehicleName} {registration}" : "")@(visit.Equipment.Length > 0 ? $" · {string.Join(", ", visit.Equipment.Select(e => e.Name))}" : "")</p>
                            @if (visit.LastReschedule is { } moved)
                            {
                                <p class="note">↻ Przesunięta z @Time(moved.OldStartUtc)–@Time(moved.OldEndUtc) (+@moved.DelayMinutes min) — @Reason(moved.Reason), @Time(moved.OccurredAtUtc)</p>
                            }
                        </article>
                    }
                </section>
            </div>

            <div class="ops-side">
                <section class="card" aria-labelledby="team">
                    <h2 id="team">Zespół <span class="count">@board.Team.Length</span></h2>
                    @foreach (var member in board.Team)
                    {
                        <article class="item member">
                            <div class="item-head">
                                <strong>@member.DisplayName</strong>
                                <span class="tag tag-state-@member.State.ToLowerInvariant()">@TeamState(member.State)</span>
                            </div>
                            <p class="muted">@MemberDetail(member)</p>
                            @if (member.PhoneNumber is { } phone)
                            {
                                <a class="btn btn-call" href="tel:@phone">Zadzwoń</a>
                            }
                        </article>
                    }
                </section>

                <section class="card" aria-labelledby="unassigned">
                    @{ var unassigned = board.Today.Where(item => item.AssignmentId is null && item.VisitStatus == "Planned").ToList();
                       var waiting = board.Incidents.Where(entry => entry.Incident.WorkOrderId is null && entry.Incident.Status is "New" or "Analyzing" or "ReadyForDispatch").ToList(); }
                    <h2 id="unassigned">Nieprzypisane <span class="count">@(unassigned.Count + waiting.Count)</span></h2>
                    @if (unassigned.Count + waiting.Count == 0)
                    {
                        <p class="muted">Wszystko ma technika.</p>
                    }
                    @foreach (var entry in waiting)
                    {
                        <article class="item"><span class="tag tag-@entry.Incident.Priority.ToLowerInvariant()">Zgłoszenie</span> @entry.Incident.Title — @entry.SiteCity, @Time(entry.Incident.RequestedStart)</article>
                    }
                    @foreach (var visit in unassigned)
                    {
                        <article class="item"><span class="tag tag-@visit.WorkOrderPriority.ToLowerInvariant()">Wizyta</span> @visit.WorkOrderTitle — @visit.SiteCity, @visit.VisitLocalStart.ToString("HH:mm")</article>
                    }
                </section>

                <section class="card" aria-labelledby="report">
                    <h2 id="report">Raport dnia</h2>
                    @if (report is null)
                    {
                        <p class="muted">Raportowanie jest niedostępne.</p>
                    }
                    else
                    {
                        <dl class="facts">
                            <dt>Wizyty</dt><dd>@report.Visits.Count</dd>
                            <dt>Zakończone</dt><dd>@report.Visits.Count(v => v.Status == "Completed")</dd>
                            <dt>Przesunięte</dt><dd>@report.Visits.Count(v => v.RescheduleCount > 0)</dd>
                            <dt>Opóźnienie</dt><dd>@report.Visits.Sum(v => v.TotalDelayMinutes) min</dd>
                        </dl>
                        <p class="muted small">Dane z @(report.Metadata.DataAsOfUtc is { } asOf ? Time(asOf) : "—") (raporty są aktualizowane z opóźnieniem).</p>
                    }
                </section>
            </div>
        </div>
    }
</div>

@code {
    private OperationsBoardResponse? board;
    private VisitActivityReport? report;
    private DateOnly? day;
    private string? error;
    private TimeZoneInfo zone = TimeZoneInfo.Utc;
    private readonly Dictionary<Guid, IncidentPanel> panels = [];

    private LiveOperationsClient? liveClient;
    private LiveConnectionState live = LiveConnectionState.Disconnected;
    private DateTimeOffset? liveUpdatedAt;
    private CancellationTokenSource? pendingRefresh;

    private sealed class IncidentPanel
    {
        public bool Busy { get; set; }
        public string? Message { get; set; }
        public string? Error { get; set; }
        public RescheduleProposal[]? Proposals { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (LiveHubAddress.Resolve(Configuration) is { } hubUrl)
        {
            liveClient = new LiveOperationsClient(hubUrl, Services.GetRequiredService<ILogger<LiveOperationsClient>>());
            liveClient.Changed += () => InvokeAsync(() => { live = liveClient.State; StateHasChanged(); });
            liveClient.Received += OnLiveMessage;
        }

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && liveClient is not null)
        {
            await liveClient.SubscribeAsync(LiveSubscription.All, CancellationToken.None);
            await liveClient.StartAsync(CancellationToken.None);
        }
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetBoardAsync(day, CancellationToken.None);
        error = result.Error;
        if (result.Value is { } loaded)
        {
            board = loaded;
            zone = TimeZoneInfo.FindSystemTimeZoneById(loaded.TimeZoneId);
            report = await Reporting.GetVisitsAsync(loaded.Date, CancellationToken.None);
        }
    }

    /// <summary>A live message is only a change hint: refresh the board from the API, once per burst of messages.</summary>
    private void OnLiveMessage(LiveOperationMessage message)
    {
        pendingRefresh?.Cancel();
        var refresh = pendingRefresh = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(400, refresh.Token);
                liveUpdatedAt = message.OccurredAtUtc;
                await LoadAsync();
                StateHasChanged();
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private async Task ShiftDayAsync(int days)
    {
        day = (day ?? board?.Date ?? DateOnly.FromDateTime(DateTime.Today)).AddDays(days);
        panels.Clear();
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        day = null;
        panels.Clear();
        await LoadAsync();
    }

    private async Task AnalyzeAsync(Guid incidentId)
    {
        var panel = Begin(incidentId);
        var result = await Api.AnalyzeAsync(incidentId, CancellationToken.None);
        if (result.Value is { } analysis)
        {
            var free = analysis.Suggestions.Count(suggestion => suggestion.SuggestionType == "DirectAssignment");
            var busy = analysis.Suggestions.Count(suggestion => suggestion.SuggestionType == "RequiresReschedule");
            panel.Message = analysis.Suggestions.FirstOrDefault(suggestion => suggestion.SuggestionType != "Unavailable") is { } best
                ? $"Najlepszy kandydat: {best.TechnicianName} — {Suggestion(best.SuggestionType)}. Wolnych: {free}, zajętych: {busy}, sprawdzono: {analysis.CandidatesEvaluated}."
                : $"Nikt z zespołu nie może przyjąć tego zgłoszenia (sprawdzono: {analysis.CandidatesEvaluated}).";
        }

        await EndAsync(panel, result.Error);
    }

    private async Task ProposeAsync(Guid incidentId)
    {
        var panel = Begin(incidentId);
        var result = await Api.ProposeAsync(incidentId, CancellationToken.None);
        panel.Proposals = result.Value;
        await EndAsync(panel, result.Error, reload: false);
    }

    private async Task AcceptAsync(Guid incidentId, RescheduleProposal proposal)
    {
        var panel = Begin(incidentId);
        var result = await Api.AcceptAsync(incidentId, proposal, CancellationToken.None);
        if (result.Value is { } applied)
        {
            panel.Proposals = null;
            panel.Message = applied.MovedVisit is { } moved
                ? $"Zaakceptowano: {proposal.TechnicianName} jedzie na zgłoszenie; wizyta przesunięta na {Time(moved.NewStartUtc)} (+{moved.DelayMinutes} min)."
                : $"Zaakceptowano: {proposal.TechnicianName} jedzie na zgłoszenie.";
        }
        else
        {
            panel.Proposals = null; // stale: the manager asks for a fresh proposal
        }

        await EndAsync(panel, result.Error);
    }

    private async Task SeedDemoAsync()
    {
        var result = await Api.SeedDemoAsync(CancellationToken.None);
        error = result.Error is null ? null : $"Dane demo są niedostępne: {result.Error}";
        day = null;
        await LoadAsync();
    }

    private IncidentPanel PanelOf(Guid incidentId) =>
        panels.TryGetValue(incidentId, out var panel) ? panel : panels[incidentId] = new IncidentPanel();

    private IncidentPanel Begin(Guid incidentId)
    {
        var panel = PanelOf(incidentId);
        (panel.Busy, panel.Error, panel.Message) = (true, null, null);
        return panel;
    }

    private async Task EndAsync(IncidentPanel panel, string? failure, bool reload = true)
    {
        panel.Error = failure;
        panel.Busy = false;
        if (reload)
        {
            await LoadAsync();
        }
    }

    private string Time(DateTimeOffset instant) => TimeZoneInfo.ConvertTime(instant, zone).ToString("HH:mm");

    private static readonly System.Globalization.CultureInfo Polish = System.Globalization.CultureInfo.GetCultureInfo("pl-PL");

    private string DayLabel => board is null ? "" : $"{board.Date.ToDateTime(TimeOnly.MinValue).ToString("dddd, d MMMM yyyy", Polish)} · {board.TimeZoneId}";

    private string LiveLabel => live switch
    {
        LiveConnectionState.Connected => "● Na żywo",
        LiveConnectionState.Connecting or LiveConnectionState.Reconnecting => "○ Łączenie…",
        _ => liveClient is null ? "Bez aktualizacji na żywo" : "○ Offline"
    };

    private string MemberDetail(OperationsBoardTechnicianResponse member) => member.State switch
    {
        "Unavailable" => member.StateDetail switch
        {
            "Absence" => "Nieobecność",
            "Holiday" => "Święto",
            "OutsideWorkingHours" => "Poza godzinami pracy",
            _ => "Nieaktywny"
        },
        "Available" => member.NextVisitStartUtc is { } next ? $"Następna wizyta {Time(next)} · dziś {member.VisitsToday}" : $"Wolny · dziś {member.VisitsToday}",
        _ => $"{member.StateDetail} — {member.CurrentSiteName}, {member.CurrentSiteCity}"
    };

    private string AlertText(OperationsBoardAlertResponse alert) => alert.Kind switch
    {
        "IncidentAwaitingDecision" => $"Pilne zgłoszenie czeka na decyzję: {alert.Subject} (od {Time(alert.At)})",
        "IncidentNeedsReschedule" => $"Konflikt: pasujący technicy są zajęci, potrzebne przesunięcie — {alert.Subject} (od {Time(alert.At)})",
        "VisitRescheduled" => $"Wizyta przesunięta o {alert.Minutes} min na {Time(alert.At)}: {alert.Subject}",
        "VisitLate" => $"Opóźnienie {alert.Minutes} min (plan {Time(alert.At)}): {alert.Subject}",
        "VisitUnassigned" => $"Brak technika ({Time(alert.At)}): {alert.Subject}",
        _ => alert.Subject
    };

    private static string Priority(string priority) => priority switch
    {
        "Low" => "Niski",
        "Normal" => "Normalny",
        "High" => "Wysoki",
        "Urgent" => "Pilny",
        "Critical" => "Krytyczny",
        _ => priority
    };

    private static string IncidentStatus(string status) => status switch
    {
        "New" => "Nowe",
        "Analyzing" => "Analiza",
        "ReadyForDispatch" => "Czeka na decyzję",
        "Dispatched" => "Wysłane",
        "Resolved" => "Rozwiązane",
        "Cancelled" => "Anulowane",
        _ => status
    };

    private static string VisitStatus(string status) => status switch
    {
        "Planned" => "zaplanowana",
        "InProgress" => "w toku",
        "Completed" => "zakończona",
        "Cancelled" => "anulowana",
        _ => status
    };

    private static string FieldWork(string status) => status switch
    {
        "NotStarted" => "Nierozpoczęta",
        "Traveling" => "W drodze",
        "Working" => "Praca",
        "Paused" => "Przerwa",
        "Completed" => "Zakończona",
        "Cancelled" => "Anulowana",
        _ => status
    };

    private static string TeamState(string state) => state switch
    {
        "Available" => "Dostępny",
        "Traveling" => "W drodze",
        "Working" => "Pracuje",
        "Paused" => "Przerwa",
        "Unavailable" => "Niedostępny",
        _ => state
    };

    private static string Suggestion(string type) => type switch
    {
        "DirectAssignment" => "wolny, przypisanie bez zmian",
        "RequiresReschedule" => "zajęty, wymaga przesunięcia",
        _ => "niedostępny"
    };

    private static readonly string[] PriorityOrder = ["Low", "Normal", "High", "Urgent"];

    /// <summary>
    /// What the manager has to know, in their words: who to tell about a move, or why a proposal cannot be done. Built from
    /// the proposal and the board; the API's own warnings are shown only when nothing more specific is known.
    /// </summary>
    private IEnumerable<string> Warnings(RescheduleProposal proposal, OperationalCalendarItemResponse? moved, string incidentPriority)
    {
        if (proposal.IsFeasible)
        {
            if (proposal.Impact.AffectedVisits.FirstOrDefault() is { } affected)
            {
                yield return $"Poinformuj klienta {moved?.CustomerName ?? "wizyty"}: wizyta przesuwa się o {affected.DelayMinutes} min.";
                if (TimeZoneInfo.ConvertTime(affected.NewStartUtc, zone).Date != TimeZoneInfo.ConvertTime(affected.OldStartUtc, zone).Date)
                {
                    yield return $"Wizyta przechodzi na {TimeZoneInfo.ConvertTime(affected.NewStartUtc, zone).ToString("dddd d MMMM", Polish)}.";
                }
            }

            yield break;
        }

        var incidentRank = Array.IndexOf(PriorityOrder, incidentPriority == "Critical" ? "Urgent" : incidentPriority);
        if (moved is not null && (moved.VisitStatus != "Planned" || moved.FieldWorkStatus != "NotStarted"))
        {
            yield return $"Kolidująca wizyta ({moved.WorkOrderTitle}) już trwa — trwającej pracy nie przesuwamy.";
        }
        else if (proposal.ConflictingPriority is { } priority && Array.IndexOf(PriorityOrder, priority) >= incidentRank)
        {
            yield return $"Kolidująca wizyta ma priorytet {Priority(priority).ToLowerInvariant()} — przesuwamy tylko pracę o niższym priorytecie.";
        }
        else
        {
            foreach (var warning in proposal.Impact.Warnings)
            {
                yield return warning;
            }
        }
    }

    private static string Reason(string reason) => reason == "UrgentIncident" ? "pilne zgłoszenie" : reason;

    public async ValueTask DisposeAsync()
    {
        pendingRefresh?.Cancel();
        if (liveClient is not null)
        {
            await liveClient.DisposeAsync();
        }
    }
}
