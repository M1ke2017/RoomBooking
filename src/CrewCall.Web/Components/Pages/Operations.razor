@page "/"
@page "/operations"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using CrewCall.Contracts.Incidents
@using CrewCall.Contracts.Live
@using CrewCall.Contracts.OperationalCalendar
@using CrewCall.Contracts.Operations
@using CrewCall.Contracts.Reporting
@using CrewCall.Web.Live
@using CrewCall.Web.Operations
@inject OperationsApiClient Api
@inject ReportingApiClient Reporting
@inject IServiceProvider Services
@inject IConfiguration Configuration

<PageTitle>CrewCall · Operacje</PageTitle>

<div class="ops">
    <header class="ops-header">
        <div>
            <h1>Operacje</h1>
            <p class="muted">@DayLabel</p>
        </div>
        <div class="ops-toolbar">
            <button class="btn" @onclick="() => ShiftDayAsync(-1)" aria-label="Poprzedni dzień">‹</button>
            <button class="btn" @onclick="TodayAsync">Dziś</button>
            <button class="btn" @onclick="() => ShiftDayAsync(1)" aria-label="Następny dzień">›</button>
            <span class="live-pill live-pill-@live.ToString().ToLowerInvariant()" title="@(liveUpdatedAt is { } at ? $"Ostatnia zmiana na żywo: {Time(at)}" : "Aktualizacje na żywo")">
                @LiveLabel
            </span>
        </div>
    </header>

    @if (refreshing && board is not null)
    {
        <p class="muted small" role="status">Trwa odświeżanie danych…</p>
    }

    @if (liveClient is not null && live == LiveConnectionState.Reconnecting)
    {
        <p class="notice notice-warn" role="status">Połączenie na żywo zostało przerwane — trwa ponowne łączenie. Dane mogą być chwilowo nieaktualne.</p>
    }
    else if (liveClient is not null && live == LiveConnectionState.Disconnected && liveStarted)
    {
        <p class="notice notice-warn" role="status">
            Brak aktualizacji na żywo — dane mogą być nieaktualne.
            <button class="btn btn-small" @onclick="ReconnectAsync">Połącz ponownie</button>
        </p>
    }

    @if (error is not null)
    {
        <p class="notice notice-error" role="alert">@error <button class="btn btn-small" @onclick="LoadAsync">Spróbuj ponownie</button></p>
    }

    @if (board is null)
    {
        @if (error is null)
        {
            <p class="muted" role="status">Wczytywanie planu dnia…</p>
        }
    }
    else
    {
        <section class="card alerts" aria-labelledby="alerts">
            <h2 id="alerts">Alerty <span class="count">@board.Alerts.Length</span></h2>
            @if (board.Alerts.Length == 0)
            {
                <p class="muted">Brak alertów — nic nie czeka na decyzję.</p>
            }
            else
            {
                <ul>
                    @foreach (var alert in board.Alerts)
                    {
                        <li class="alert alert-@alert.Severity.ToLowerInvariant()">@AlertText(alert)</li>
                    }
                </ul>
            }
        </section>

        <div class="ops-grid">
            <div class="ops-main">
                <section class="card" aria-labelledby="urgent">
                    <h2 id="urgent">Pilne zgłoszenia <span class="count">@board.Incidents.Length</span></h2>
                    @if (board.Incidents.Length == 0)
                    {
                        <p class="muted">Brak pilnych zgłoszeń.</p>
                    }
                    @foreach (var entry in board.Incidents)
                    {
                        var incident = entry.Incident;
                        var panel = PanelOf(incident.Id);
                        var open = IsOpen(incident);
                        <article class="item incident @(open ? "incident-open" : "")">
                            <div class="item-head">
                                <span class="tag tag-@incident.Priority.ToLowerInvariant()">@Priority(incident.Priority)</span>
                                <strong>@incident.Title</strong>
                                <span class="tag tag-status">@IncidentStatus(incident.Status)</span>
                            </div>
                            <p>@entry.CustomerName — @entry.SiteName, @entry.SiteCity</p>
                            <p class="muted">Termin @Time(incident.RequestedStart)–@Time(incident.RequestedEnd)@(incident.RequiredSkillCodes.Length > 0 ? $" · wymagane umiejętności: {string.Join(", ", incident.RequiredSkillCodes)}" : "")</p>
                            @if (open && entry.Analysis is { } analysis)
                            {
                                <p class="muted">
                                    Analiza z @Time(analysis.AnalyzedAtUtc): @analysis.DirectAssignmentCount wolnych ·
                                    @analysis.RequiresRescheduleCount z konfliktem (możliwe przeplanowanie) · @analysis.UnavailableCount niedostępnych
                                </p>
                            }
                            @if (open)
                            {
                                <p class="next-step">@NextStep(entry)</p>
                            }
                            @if (panel.Message is { } message)
                            {
                                <p class="notice notice-ok" role="status">@message</p>
                            }
                            @if (panel.Error is { } panelError)
                            {
                                <p class="notice notice-error" role="alert">@panelError</p>
                            }
                            @if (open && panel.Proposals is null)
                            {
                                <div class="actions">
                                    <button class="btn @(incident.Status == "New" ? "btn-primary" : "")" disabled="@panel.Busy" @onclick="() => AnalyzeAsync(incident.Id)">Analizuj</button>
                                    <button class="btn @(incident.Status == "ReadyForDispatch" ? "btn-primary" : "")" disabled="@(panel.Busy || incident.Status != "ReadyForDispatch")" @onclick="() => ProposeAsync(incident.Id)">Pokaż propozycję</button>
                                </div>
                            }
                            @if (open && panel.Proposals is { } proposals)
                            {
                                @if (proposals.Length == 0)
                                {
                                    <p class="muted">Brak propozycji: nikt z zespołu nie może przyjąć tego zgłoszenia.</p>
                                }
                                @foreach (var proposal in proposals.Take(3))
                                {
                                    var moved = proposal.ConflictingVisitId is { } conflictingId ? board.Today.FirstOrDefault(item => item.VisitId == conflictingId) : null;
                                    var affected = proposal.Impact.AffectedVisits.FirstOrDefault();
                                    <div class="proposal @(proposal.IsFeasible ? "" : "proposal-infeasible")">
                                        <div class="item-head">
                                            <strong>@proposal.TechnicianName</strong>
                                            <span class="tag @(proposal.IsFeasible ? (proposal.ConflictingVisitId is null ? "tag-ok" : "tag-high") : "tag-bad")">@ProposalLabel(proposal)</span>
                                        </div>
                                        <dl class="facts">
                                            <dt>Technik</dt><dd>@proposal.TechnicianName</dd>
                                            <dt>Zgłoszenie</dt><dd>@Time(proposal.UrgentVisitStartUtc)–@Time(proposal.UrgentVisitEndUtc)</dd>
                                            @if (proposal.ConflictingVisitId is not null)
                                            {
                                                <dt>Kolidująca wizyta</dt><dd>@(moved?.WorkOrderTitle ?? "wizyta technika") (priorytet @Priority(proposal.ConflictingPriority ?? "").ToLowerInvariant())</dd>
                                            }
                                            @if (proposal.IsFeasible && proposal.ProposedNewStartUtc is { } newStart && affected is not null)
                                            {
                                                <dt>Obecny termin</dt><dd>@Time(affected.OldStartUtc)–@Time(affected.OldEndUtc)</dd>
                                                <dt>Nowy termin</dt><dd><strong>@Time(newStart)–@Time(proposal.ProposedNewEndUtc!.Value)</strong>@(DayChange(affected))</dd>
                                                <dt>Klient</dt><dd>@(moved is null ? "—" : $"{moved.CustomerName} — {moved.SiteName}, {moved.SiteCity}")</dd>
                                                <dt>Opóźnienie</dt><dd>@Duration(affected.DelayMinutes)</dd>
                                                <dt>Pojazd</dt><dd>@(moved?.VehicleRegistrationNumber is { } registration ? $"{moved.VehicleName} {registration}" : "—")</dd>
                                                <dt>Sprzęt</dt><dd>@(moved is { Equipment.Length: > 0 } ? string.Join(", ", moved.Equipment.Select(e => e.Name)) : "—")</dd>
                                            }
                                        </dl>
                                        @foreach (var warning in Warnings(proposal, moved, incident.Priority))
                                        {
                                            <p class="warning">⚠ @warning</p>
                                        }
                                        @if (proposal.IsFeasible)
                                        {
                                            <div class="actions">
                                                <button class="btn btn-primary" disabled="@panel.Busy" @onclick="() => AcceptAsync(incident.Id, proposal)">Zatwierdź zmianę</button>
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="actions">
                                    <button class="btn" disabled="@panel.Busy" @onclick="() => Back(incident.Id)">Wróć</button>
                                </div>
                            }
                        </article>
                    }
                </section>

                <section class="card" aria-labelledby="today">
                    <h2 id="today">Dzisiaj <span class="count">@board.Today.Length</span></h2>
                    @if (board.Today.Length == 0)
                    {
                        <p class="muted">Brak zaplanowanych wizyt na ten dzień.</p>
                        @if (day is null)
                        {
                            <button class="btn" @onclick="SeedDemoAsync">Przygotuj dane demo</button>
                        }
                    }
                    @foreach (var visit in board.Today)
                    {
                        <article class="item visit visit-@visit.FieldWorkStatus.ToLowerInvariant()">
                            <div class="item-head">
                                <span class="time">@visit.VisitLocalStart.ToString("HH:mm")–@visit.VisitLocalEnd.ToString("HH:mm")</span>
                                <strong>@(visit.TechnicianName ?? "Bez technika")</strong>
                                <span class="tag tag-@visit.WorkOrderPriority.ToLowerInvariant()">@Priority(visit.WorkOrderPriority)</span>
                                <span class="tag tag-work-@visit.FieldWorkStatus.ToLowerInvariant()">@FieldWork(visit.FieldWorkStatus, visit.VisitStatus)</span>
                            </div>
                            <p>@visit.CustomerName — @visit.SiteName, @visit.SiteCity</p>
                            <p class="muted">@visit.WorkOrderTitle@(visit.VehicleRegistrationNumber is { } registration ? $" · {visit.VehicleName} {registration}" : "")@(visit.Equipment.Length > 0 ? $" · {string.Join(", ", visit.Equipment.Select(e => e.Name))}" : "")</p>
                            @if (visit.LastReschedule is { } moved)
                            {
                                <p class="note">↻ Przesunięta z @Time(moved.OldStartUtc)–@Time(moved.OldEndUtc) (+@Duration(moved.DelayMinutes)) — @Reason(moved.Reason), decyzja z @Time(moved.OccurredAtUtc)</p>
                            }
                        </article>
                    }
                </section>
            </div>

            <div class="ops-side">
                <section class="card" aria-labelledby="unassigned">
                    @{ var unassigned = board.Today.Where(item => item.AssignmentId is null && item.VisitStatus == "Planned").ToList();
                       var waiting = board.Incidents.Where(entry => IsOpen(entry.Incident)).ToList(); }
                    <h2 id="unassigned">Nieprzypisane <span class="count">@(unassigned.Count + waiting.Count)</span></h2>
                    @if (unassigned.Count + waiting.Count == 0)
                    {
                        <p class="muted">Brak nieprzypisanych wizyt.</p>
                    }
                    @foreach (var entry in waiting)
                    {
                        <article class="item"><span class="tag tag-@entry.Incident.Priority.ToLowerInvariant()">Zgłoszenie</span> @entry.Incident.Title — @entry.SiteCity, @Time(entry.Incident.RequestedStart)</article>
                    }
                    @foreach (var visit in unassigned)
                    {
                        <article class="item"><span class="tag tag-@visit.WorkOrderPriority.ToLowerInvariant()">Wizyta</span> @visit.WorkOrderTitle — @visit.SiteCity, @visit.VisitLocalStart.ToString("HH:mm")</article>
                    }
                </section>

                <section class="card" aria-labelledby="team">
                    <h2 id="team">Zespół <span class="count">@board.Team.Length</span></h2>
                    @if (board.Team.Length == 0)
                    {
                        <p class="muted">Brak aktywnych techników.</p>
                    }
                    @foreach (var member in board.Team)
                    {
                        <article class="item member">
                            <div class="item-head">
                                <strong>@member.DisplayName</strong>
                                <span class="tag tag-state-@member.State.ToLowerInvariant()">@TeamState(member.State)</span>
                            </div>
                            <p class="muted">@MemberDetail(member)</p>
                            @if (member.PhoneNumber is { } phone)
                            {
                                <a class="btn btn-call" href="tel:@phone" aria-label="Zadzwoń do: @member.DisplayName">Zadzwoń</a>
                            }
                        </article>
                    }
                </section>

                <section class="card" aria-labelledby="report">
                    <h2 id="report">Raport dnia</h2>
                    @if (report is null)
                    {
                        <p class="muted">Raport jest chwilowo niedostępny.</p>
                    }
                    else if (report.Visits.Count == 0)
                    {
                        <p class="muted">Brak danych w raporcie dla tego dnia.</p>
                    }
                    else
                    {
                        <dl class="facts">
                            <dt>Wizyty</dt><dd>@report.Visits.Count</dd>
                            <dt>Zakończone</dt><dd>@report.Visits.Count(v => v.Status == "Completed")</dd>
                            <dt>Czas pracy</dt><dd>@Duration(report.Visits.Sum(v => v.ActualNetWorkMinutes ?? 0))</dd>
                            <dt>Dojazdy</dt><dd>@Duration(report.Visits.Sum(v => v.ActualTravelMinutes ?? 0))</dd>
                            <dt>Przerwy</dt><dd>@Duration(report.Visits.Sum(v => v.ActualPauseMinutes ?? 0))</dd>
                            <dt>Przesunięte</dt><dd>@report.Visits.Count(v => v.RescheduleCount > 0)</dd>
                            <dt>Łączne opóźnienie</dt><dd>@Duration(report.Visits.Sum(v => v.TotalDelayMinutes))</dd>
                        </dl>
                        <p class="muted small">Stan na @(report.Metadata.DataAsOfUtc is { } asOf ? Time(asOf) : "—"). Raport aktualizuje się z niewielkim opóźnieniem.</p>
                    }
                </section>
            </div>
        </div>
    }
</div>

@code {
    private OperationsBoardResponse? board;
    private VisitActivityReport? report;
    private DateOnly? day;
    private string? error;
    private TimeZoneInfo zone = TimeZoneInfo.Utc;
    private readonly Dictionary<Guid, IncidentPanel> panels = [];

    private LiveOperationsClient? liveClient;
    private LiveConnectionState live = LiveConnectionState.Disconnected;
    private DateTimeOffset? liveUpdatedAt;
    private CancellationTokenSource? pendingRefresh;
    private bool refreshing;
    private bool liveStarted;

    private sealed class IncidentPanel
    {
        public bool Busy { get; set; }
        public string? Message { get; set; }
        public string? Error { get; set; }
        public RescheduleProposal[]? Proposals { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (LiveHubAddress.Resolve(Configuration) is { } hubUrl)
        {
            liveClient = new LiveOperationsClient(hubUrl, Services.GetRequiredService<ILogger<LiveOperationsClient>>());
            liveClient.Changed += () => InvokeAsync(OnLiveStateChangedAsync);
            liveClient.Received += OnLiveMessage;
        }

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && liveClient is not null)
        {
            await liveClient.SubscribeAsync(LiveSubscription.All, CancellationToken.None);
            await ReconnectAsync();
        }
    }

    private async Task ReconnectAsync()
    {
        liveStarted = true;
        await liveClient!.StartAsync(CancellationToken.None);
    }

    /// <summary>After a reconnect, messages may have been missed: read the board again.</summary>
    private async Task OnLiveStateChangedAsync()
    {
        var previous = live;
        live = liveClient!.State;
        if (previous == LiveConnectionState.Reconnecting && live == LiveConnectionState.Connected)
        {
            await LoadAsync();
        }

        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        refreshing = true;
        try
        {
            var result = await Api.GetBoardAsync(day, CancellationToken.None);
            error = result.Error;
            if (result.Value is { } loaded)
            {
                board = loaded;
                zone = TimeZoneInfo.FindSystemTimeZoneById(loaded.TimeZoneId);
                report = await Reporting.GetVisitsAsync(loaded.Date, CancellationToken.None);
            }
        }
        finally
        {
            refreshing = false;
        }
    }

    /// <summary>A live message is only a change hint: refresh the board from the API, once per burst of messages.</summary>
    private void OnLiveMessage(LiveOperationMessage message)
    {
        pendingRefresh?.Cancel();
        var refresh = pendingRefresh = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(400, refresh.Token);
                liveUpdatedAt = message.OccurredAtUtc;
                await LoadAsync();
                StateHasChanged();
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private async Task ShiftDayAsync(int days)
    {
        day = (day ?? board?.Date ?? DateOnly.FromDateTime(DateTime.Today)).AddDays(days);
        panels.Clear();
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        day = null;
        panels.Clear();
        await LoadAsync();
    }

    private async Task AnalyzeAsync(Guid incidentId)
    {
        var panel = Begin(incidentId);
        var result = await Api.AnalyzeAsync(incidentId, CancellationToken.None);
        if (result.Value is { } analysis)
        {
            var free = analysis.Suggestions.Count(suggestion => suggestion.SuggestionType == "DirectAssignment");
            var busy = analysis.Suggestions.Count(suggestion => suggestion.SuggestionType == "RequiresReschedule");
            panel.Message = analysis.Suggestions.FirstOrDefault(suggestion => suggestion.SuggestionType != "Unavailable") is { } best
                ? $"Rekomendowany technik: {best.TechnicianName} — {Suggestion(best.SuggestionType)}. Wolnych: {free}, z konfliktem: {busy}."
                : "Nikt z zespołu nie może przyjąć tego zgłoszenia w tym terminie.";
        }

        await EndAsync(panel, result.Error);
    }

    private async Task ProposeAsync(Guid incidentId)
    {
        var panel = Begin(incidentId);
        var result = await Api.ProposeAsync(incidentId, CancellationToken.None);
        panel.Proposals = result.Value;
        await EndAsync(panel, result.Error, reload: false);
    }

    private async Task AcceptAsync(Guid incidentId, RescheduleProposal proposal)
    {
        var panel = Begin(incidentId);
        var result = await Api.AcceptAsync(incidentId, proposal, CancellationToken.None);
        if (result.Value is { } applied)
        {
            panel.Proposals = null;
            panel.Message = applied.MovedVisit is { } moved
                ? $"Zmiana zatwierdzona: {proposal.TechnicianName} jedzie na zgłoszenie, wizyta przesunięta na {Time(moved.NewStartUtc)}–{Time(moved.NewEndUtc)} (+{Duration(moved.DelayMinutes)})."
                : $"Zmiana zatwierdzona: {proposal.TechnicianName} jedzie na zgłoszenie.";
        }
        else
        {
            panel.Proposals = null; // stale: the manager asks for a fresh proposal
        }

        await EndAsync(panel, result.Error);
    }

    private async Task SeedDemoAsync()
    {
        var result = await Api.SeedDemoAsync(CancellationToken.None);
        error = result.Error is null ? null : "Nie udało się przygotować danych demo. Dane demo są dostępne przy uruchomieniu przez CrewCall.AppHost.";
        day = null;
        await LoadAsync();
    }

    private void Back(Guid incidentId)
    {
        var panel = PanelOf(incidentId);
        (panel.Proposals, panel.Error) = (null, null);
    }

    private static bool IsOpen(IncidentResponse incident) =>
        incident.WorkOrderId is null && incident.Status is "New" or "Analyzing" or "ReadyForDispatch";

    /// <summary>What the manager can do next with the incident.</summary>
    private static string NextStep(OperationsBoardIncidentResponse entry) => (entry.Incident.Status, entry.Analysis) switch
    {
        ("New", _) => "Następny krok: przeanalizuj zgłoszenie, aby znaleźć technika.",
        ("Analyzing", _) => "Trwa analiza zgłoszenia…",
        (_, { DirectAssignmentCount: > 0 }) => "Następny krok: pokaż propozycję — jest wolny technik.",
        (_, { RequiresRescheduleCount: > 0 }) => "Konflikt — możliwe przeplanowanie. Następny krok: pokaż propozycję przeplanowania.",
        _ => "Nikt z zespołu nie jest dostępny — rozważ inny termin."
    };

    private static string ProposalLabel(RescheduleProposal proposal) =>
        !proposal.IsFeasible ? "Niemożliwe"
        : proposal.ConflictingVisitId is null ? "Bez zmian w planie"
        : "Przeplanowanie 1 wizyty";

    private string DayChange(AffectedVisit affected)
    {
        var (oldDay, newDay) = (TimeZoneInfo.ConvertTime(affected.OldStartUtc, zone).Date, TimeZoneInfo.ConvertTime(affected.NewStartUtc, zone).Date);
        return oldDay == newDay ? "" : $" ({TimeZoneInfo.ConvertTime(affected.NewStartUtc, zone).ToString("dddd d MMMM", Polish)})";
    }

    private static string Duration(decimal minutes) => Duration((int)Math.Round(minutes));

    private static string Duration(int minutes) =>
        minutes < 60 ? $"{minutes} min"
        : minutes % 60 == 0 ? $"{minutes / 60} h"
        : $"{minutes / 60} h {minutes % 60} min";

    private IncidentPanel PanelOf(Guid incidentId) =>
        panels.TryGetValue(incidentId, out var panel) ? panel : panels[incidentId] = new IncidentPanel();

    private IncidentPanel Begin(Guid incidentId)
    {
        var panel = PanelOf(incidentId);
        (panel.Busy, panel.Error, panel.Message) = (true, null, null);
        return panel;
    }

    private async Task EndAsync(IncidentPanel panel, string? failure, bool reload = true)
    {
        panel.Error = failure;
        panel.Busy = false;
        if (reload)
        {
            await LoadAsync();
        }
    }

    private string Time(DateTimeOffset instant) => TimeZoneInfo.ConvertTime(instant, zone).ToString("HH:mm");

    private static readonly System.Globalization.CultureInfo Polish = System.Globalization.CultureInfo.GetCultureInfo("pl-PL");

    private string DayLabel => board is null ? "" : board.Date.ToDateTime(TimeOnly.MinValue).ToString("dddd, d MMMM yyyy", Polish);

    private string LiveLabel => live switch
    {
        LiveConnectionState.Connected => "● Na żywo",
        LiveConnectionState.Connecting or LiveConnectionState.Reconnecting => "○ Łączenie…",
        _ => liveClient is null ? "Bez aktualizacji na żywo" : "○ Brak połączenia"
    };

    private string MemberDetail(OperationsBoardTechnicianResponse member) => member.State switch
    {
        "Unavailable" => member.StateDetail switch
        {
            "Absence" => "Nieobecność",
            "Holiday" => "Święto",
            "OutsideWorkingHours" => "Poza godzinami pracy",
            _ => "Nieaktywny"
        },
        "Available" => member.NextVisitStartUtc is { } next ? $"Następna wizyta o {Time(next)} · wizyt dziś: {member.VisitsToday}" : $"Brak kolejnych wizyt · wizyt dziś: {member.VisitsToday}",
        _ => $"{member.StateDetail} — {member.CurrentSiteName}, {member.CurrentSiteCity}"
    };

    private string AlertText(OperationsBoardAlertResponse alert) => alert.Kind switch
    {
        "IncidentAwaitingDecision" => $"Pilne zgłoszenie czeka na decyzję: {alert.Subject} (termin {Time(alert.At)}). Przeanalizuj je.",
        "IncidentNeedsReschedule" => $"Konflikt — możliwe przeplanowanie: {alert.Subject} (termin {Time(alert.At)}). Pokaż propozycję.",
        "VisitRescheduled" => $"Wizyta przesunięta na {Time(alert.At)} (+{Duration(alert.Minutes ?? 0)}): {alert.Subject}. Poinformuj klienta.",
        "VisitLate" => $"Opóźnienie {Duration(alert.Minutes ?? 0)} (plan {Time(alert.At)}): {alert.Subject}. Skontaktuj się z technikiem.",
        "VisitUnassigned" => $"Wizyta bez technika ({Time(alert.At)}): {alert.Subject}.",
        _ => alert.Subject
    };

    private static string Priority(string priority) => priority switch
    {
        "Low" => "Niski",
        "Normal" => "Normalny",
        "High" => "Wysoki",
        "Urgent" => "Pilny",
        "Critical" => "Krytyczny",
        _ => priority
    };

    private static string IncidentStatus(string status) => status switch
    {
        "New" => "Nowe",
        "Analyzing" => "Analiza",
        "ReadyForDispatch" => "Czeka na decyzję",
        "Dispatched" => "Technik w drodze",
        "Resolved" => "Rozwiązane",
        "Cancelled" => "Anulowane",
        _ => status
    };

    /// <summary>One label per visit: what is happening on site, or the plan when nothing has started.</summary>
    private static string FieldWork(string status, string visitStatus) => status switch
    {
        "NotStarted" => visitStatus == "Cancelled" ? "Anulowana" : "Zaplanowana",
        "Traveling" => "W drodze",
        "Working" => "Praca",
        "Paused" => "Przerwa",
        "Completed" => "Zakończona",
        "Cancelled" => "Anulowana",
        _ => status
    };

    private static string TeamState(string state) => state switch
    {
        "Available" => "Dostępny",
        "Traveling" => "W drodze",
        "Working" => "Pracuje",
        "Paused" => "Przerwa",
        "Unavailable" => "Niedostępny",
        _ => state
    };

    private static string Suggestion(string type) => type switch
    {
        "DirectAssignment" => "wolny, można przypisać od razu",
        "RequiresReschedule" => "konflikt — możliwe przeplanowanie",
        _ => "niedostępny"
    };

    private static readonly string[] PriorityOrder = ["Low", "Normal", "High", "Urgent"];

    /// <summary>
    /// What the manager has to know, in their words: who to tell about a move, or why a proposal cannot be done. Built from
    /// the proposal and the board; the API's own warnings are shown only when nothing more specific is known.
    /// </summary>
    private IEnumerable<string> Warnings(RescheduleProposal proposal, OperationalCalendarItemResponse? moved, string incidentPriority)
    {
        if (proposal.IsFeasible)
        {
            if (proposal.Impact.AffectedVisits.FirstOrDefault() is { } affected)
            {
                yield return $"Po zatwierdzeniu poinformuj klienta {moved?.CustomerName ?? "przesuwanej wizyty"} o nowym terminie (+{Duration(affected.DelayMinutes)}).";
            }

            yield break;
        }

        var incidentRank = Array.IndexOf(PriorityOrder, incidentPriority == "Critical" ? "Urgent" : incidentPriority);
        if (moved is not null && (moved.VisitStatus != "Planned" || moved.FieldWorkStatus != "NotStarted"))
        {
            yield return $"Kolidująca wizyta ({moved.WorkOrderTitle}) już trwa — trwającej pracy nie przesuwamy.";
        }
        else if (proposal.ConflictingPriority is { } priority && Array.IndexOf(PriorityOrder, priority) >= incidentRank)
        {
            yield return $"Kolidująca wizyta ma priorytet {Priority(priority).ToLowerInvariant()} — przesuwamy tylko pracę o niższym priorytecie.";
        }
        else
        {
            yield return "Ten wariant nie zwalnia terminu: kolidującej pracy nie da się przesunąć bez kolejnych zmian.";
        }
    }

    private static string Reason(string reason) => reason == "UrgentIncident" ? "pilne zgłoszenie" : reason;

    public async ValueTask DisposeAsync()
    {
        pendingRefresh?.Cancel();
        if (liveClient is not null)
        {
            await liveClient.DisposeAsync();
        }
    }
}
