@page "/Error"
@using System.Diagnostics

<PageTitle>CrewCall · Błąd</PageTitle>

<section class="panel">
    <h1>Wystąpił błąd</h1>
    <p>Nie udało się obsłużyć żądania. Wróć do <a href="/operations">Operacji</a> i spróbuj ponownie.</p>
    @if (!string.IsNullOrEmpty(RequestId))
    {
        <p class="muted">Identyfikator żądania (dla zespołu technicznego): <code>@RequestId</code></p>
    }
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId => Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
