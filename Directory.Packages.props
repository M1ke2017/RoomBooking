<Project>

  <!-- Central package management: versions live here, projects reference packages without versions. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="F#">
    <!-- Explicit because central package management disables the F# SDK's implicit FSharp.Core reference. -->
    <PackageVersion Include="FSharp.Core" Version="10.0.112" />
  </ItemGroup>

  <ItemGroup Label="Web (Blazor WebAssembly)">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
  </ItemGroup>

</Project>
