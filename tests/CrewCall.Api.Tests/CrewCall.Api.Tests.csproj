<Project Sdk="Microsoft.NET.Sdk">

  <!--
    API tests: hosts CrewCall.Api in-process with WebApplicationFactory against a real PostgreSQL
    started by Testcontainers (requires Docker). No Aspire.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CrewCall.Api\CrewCall.Api.csproj" />
  </ItemGroup>

</Project>
