<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit and property-based tests for the pure F# scheduling core. References only CrewCall.Scheduling.Core. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestRanges.fs" />
    <Compile Include="TimeRangeTests.fs" />
    <Compile Include="TimeRangePropertyTests.fs" />
    <Compile Include="TimeRangeHelperTests.fs" />
    <Compile Include="RangesTests.fs" />
    <Compile Include="SkillsTests.fs" />
    <Compile Include="FeasibilityTests.fs" />
    <Compile Include="SchedulingPropertyTests.fs" />
    <Compile Include="ResourceConflictsTests.fs" />
    <Compile Include="MatchingTests.fs" />
    <Compile Include="DispatchSuggestionsTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FsCheck.Xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CrewCall.Scheduling.Core\CrewCall.Scheduling.Core.fsproj" />
  </ItemGroup>

</Project>
