<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit and property-based tests for the pure F# scheduling core. References only CrewCall.Scheduling.Core. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TimeRangeTests.fs" />
    <Compile Include="TimeRangePropertyTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FsCheck.Xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CrewCall.Scheduling.Core\CrewCall.Scheduling.Core.fsproj" />
  </ItemGroup>

</Project>
