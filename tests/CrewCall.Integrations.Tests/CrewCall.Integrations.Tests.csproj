<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Messaging tests (ADR-0014, ADR-0015): the outbox publisher, the consumers and their inboxes, the live operations hub
    and its Web client, and the full pipeline against a real PostgreSQL and a real RabbitMQ, both started by
    Testcontainers (requires Docker). CrewCall.Web is referenced under the "web" alias: both hosts have a Program class.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CrewCall.Integrations\CrewCall.Integrations.csproj" />
    <ProjectReference Include="..\..\src\CrewCall.Web\CrewCall.Web.csproj" Aliases="web" />
  </ItemGroup>

</Project>
