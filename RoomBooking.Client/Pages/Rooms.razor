@page "/rooms"
@using RoomBooking.Client.Models
@using RoomBooking.Client.Services
@inject HttpClient Http
@inject ActivityLogService Log

<h3>Sale</h3>

@if (rooms == null)
{
    <p>Ładowanie...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nazwa</th>
                <th>Pojemność</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in rooms)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.Name</td>
                    <td>@r.Capacity</td>
                </tr>
            }
        </tbody>
    </table>
}

<h4>Dodaj salę</h4>

<div class="mb-3">
    <label class="form-label">Nazwa</label>
    <input class="form-control" @bind="newRoom.Name" />
</div>
<div class="mb-3">
    <label class="form-label">Pojemność</label>
    <input type="number" class="form-control" @bind="newRoom.Capacity" />
</div>
<button class="btn btn-primary" @onclick="AddRoom">Dodaj</button>

@code {
    private List<Room>? rooms;
    private Room newRoom = new Room { Capacity = 10 };

    protected override async Task OnInitializedAsync()
    {
        rooms = await Http.GetFromJsonAsync<List<Room>>("api/rooms");
        Log.Add("Rooms", $"Pobrano listę sal (liczba: {rooms?.Count ?? 0}).");
    }

    private async Task AddRoom()
    {
        var response = await Http.PostAsJsonAsync("api/rooms", newRoom);
        if (response.IsSuccessStatusCode)
        {
            var created =
                await response.Content.ReadFromJsonAsync<Room>();
            rooms!.Add(created!);
            Log.Add("Rooms", $"Dodano salę '{created!.Name}' (Id={created.Id}, Capacity={created.Capacity}).");
            newRoom = new Room { Capacity = 10 };
        }
    }
}
