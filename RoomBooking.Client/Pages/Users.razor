@page "/users"
@using RoomBooking.Client.Models
@using RoomBooking.Client.Services
@inject HttpClient Http
@inject ActivityLogService Log

<h3>Użytkownicy</h3>

@if (users == null)
{
    <p>Ładowanie...</p>
}
else
{
    <ul>
        @foreach (var u in users)
        {
            <li>@u.Name (@u.Email)</li>
        }
    </ul>
}

<h4>Dodaj użytkownika</h4>

<div class="mb-3">
    <label class="form-label">Imię i nazwisko</label>
    <input class="form-control" @bind="newUser.Name" />
</div>
<div class="mb-3">
    <label class="form-label">Email</label>
    <input class="form-control" @bind="newUser.Email" />
</div>
<button class="btn btn-primary" @onclick="AddUser">Dodaj</button>

@code {
    private List<User>? users;
    private User newUser = new();

    protected override async Task OnInitializedAsync()
    {
        users = await Http.GetFromJsonAsync<List<User>>("api/users");
    }

    private async Task AddUser()
    {
        var response = await Http.PostAsJsonAsync("api/users", newUser);
        Log.Add("Users", $"Pobrano listę użytkowników (liczba: {users?.Count ?? 0}).");
        if (response.IsSuccessStatusCode)
        {
            var created = await response.Content.ReadFromJsonAsync<User>();
            users!.Add(created!);
            Log.Add("Users", $"Dodano użytkownika '{created!.Name}' ({created.Email}).");
            newUser = new User();
        }
    }
}
