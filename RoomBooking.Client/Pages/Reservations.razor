@page "/reservations"

@using System.Net.Http.Json
@using RoomBooking.Client.Models
@using RoomBooking.Client.Services
@inject HttpClient Http
@inject ActivityLogService Log

<h3>Rezerwacje</h3>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (reservations == null)
{
    <p>Ładowanie...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Sala</th>
                <th>Użytkownik</th>
                <th>Od</th>
                <th>Do</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in reservations)
            {
                var roomName = rooms?.FirstOrDefault(x => x.Id == r.RoomId)?.Name ?? r.RoomId.ToString();
                var userName = users?.FirstOrDefault(x => x.Id == r.UserId)?.Name ?? r.UserId.ToString();
                <tr>
                    <td>@r.Id</td>
                    <td>@roomName</td>
                    <td>@userName</td>
                    <td>@r.StartUtc.ToLocalTime()</td>
                    <td>@r.EndUtc.ToLocalTime()</td>
                    <td>@r.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

<h4>Nowa rezerwacja</h4>

@if (rooms == null || users == null)
{
    <p>Ładowanie danych sal i użytkowników...</p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <div class="mb-3">
                <label class="form-label">Sala</label>
                <select class="form-select" @bind="newReservation.RoomId">
                    <option value="0">-- wybierz salę --</option>
                    @foreach (var r in rooms)
                    {
                        <option value="@r.Id">@r.Name</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Użytkownik</label>
                <select class="form-select" @bind="newReservation.UserId">
                    <option value="0">-- wybierz użytkownika --</option>
                    @foreach (var u in users)
                    {
                        <option value="@u.Id">@u.Name</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Data</label>
                <input type="date"
                       class="form-control"
                       @bind="date" />
            </div>

            <div class="mb-3">
                <label class="form-label">Od (godzina)</label>
                <input type="time"
                       class="form-control"
                       @bind="startTime" />
            </div>

            <div class="mb-3">
                <label class="form-label">Do (godzina)</label>
                <input type="time"
                       class="form-control"
                       @bind="endTime" />
            </div>

            <button class="btn btn-primary" @onclick="AddReservation">
                Zarezerwuj
            </button>
        </div>
    </div>
}

@code {
    private List<Room>? rooms;
    private List<User>? users;
    private List<Reservation>? reservations;

    private Reservation newReservation = new();

    
    private DateTime date = DateTime.Today;
    private TimeOnly startTime = new TimeOnly(10, 0);
    private TimeOnly endTime = new TimeOnly(11, 0);

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        rooms = await Http.GetFromJsonAsync<List<Room>>("api/rooms");
        users = await Http.GetFromJsonAsync<List<User>>("api/users");
        reservations = await Http.GetFromJsonAsync<List<Reservation>>("api/reservations");
        Log.Add("Reservations",
        $"Pobrano dane początkowe: {rooms?.Count ?? 0} sal, {users?.Count ?? 0} użytkowników, {reservations?.Count ?? 0} rezerwacji.");
    }

    private async Task AddReservation()
    {
        errorMessage = null;

        if (newReservation.RoomId == 0 || newReservation.UserId == 0)
        {
            errorMessage = "Wybierz salę i użytkownika.";
            return;
        }

        // składamy DateTime z daty + TimeOnly
        var startLocal = date.Date.Add(startTime.ToTimeSpan());
        var endLocal = date.Date.Add(endTime.ToTimeSpan());

        if (endLocal <= startLocal)
        {
            errorMessage = "Godzina końca musi być później niż początek.";
            return;
        }

        newReservation.StartUtc = startLocal.ToUniversalTime();
        newReservation.EndUtc = endLocal.ToUniversalTime();
        newReservation.Status = ReservationStatus.Active;

        var response = await Http.PostAsJsonAsync("api/reservations", newReservation);

        if (response.IsSuccessStatusCode)
        {
            var created = await response.Content.ReadFromJsonAsync<Reservation>();
            reservations!.Add(created!);

            var roomName = rooms?.FirstOrDefault(r => r.Id == created!.RoomId)?.Name ?? created.RoomId.ToString();
            var userName = users?.FirstOrDefault(u => u.Id == created!.UserId)?.Name ?? created.UserId.ToString();

            Log.Add("Reservations",
                $"Dodano rezerwację (Id={created!.Id}) – Sala: {roomName}, Użytkownik: {userName}, " +
                $"Od: {created.StartUtc.ToLocalTime()}, Do: {created.EndUtc.ToLocalTime()}.");
        }
        else
        {
            var text = await response.Content.ReadAsStringAsync();

            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                errorMessage = "Sala jest już zajęta w tym czasie.";
                Log.Add("Reservations", "Nie udało się dodać rezerwacji – konflikt terminu.");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest &&
                     text.Contains("holiday", StringComparison.OrdinalIgnoreCase))
            {
                errorMessage = "Nie można rezerwować w dzień świąteczny (weekend).";
                Log.Add("Reservations", "Nie udało się dodać rezerwacji – dzień świąteczny (weekend).");
            }
            else
            {
                errorMessage = $"Błąd podczas tworzenia rezerwacji: {response.StatusCode}";
                Log.Add("Reservations", $"Nie udało się dodać rezerwacji – błąd {response.StatusCode}.");
            }
        }

    }
}
